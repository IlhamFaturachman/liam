# LIAM Configuration

# Server
LIAM_PORT=666

# Database
# LIAM_DB_PATH=/path/to/data.db

# Anti-ban settings
LIAM_ACCOUNT_RPM=10
LIAM_ACCOUNT_MIN_GAP=6
LIAM_STICKY_REQUESTS=3
LIAM_COOLDOWN_BASE=60
LIAM_COOLDOWN_MAX=1800
LIAM_DISABLE_AFTER_ERRORS=10

# Antigravity OAuth (required for harvest)
# Get these from Google Cloud Console or use Antigravity IDE's public credentials
LIAM_AG_CLIENT_ID=
LIAM_AG_CLIENT_SECRET=

# Optional: Supabase sync
# SUPABASE_URL=
# SUPABASE_KEY=
